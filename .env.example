# ---- Copy to .env and fill in. Never commit .env. ----
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-run: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=sales.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sales.yourdomain.com
SITE_URL=https://sales.yourdomain.com
TIME_ZONE=Asia/Kolkata

# PostgreSQL
DATABASE_URL=postgresql://flotec:CHANGE_ME@localhost:5432/flotec

# Encrypts OAuth tokens at rest. Generate once and keep it safe (losing it means reconnecting mailboxes):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Claude API (console.anthropic.com -> API keys). Leave empty to run without AI agents.
ANTHROPIC_API_KEY=
# Optional: OpenRouter (openrouter.ai -> Keys) for e-mail drafting, reply classification and report
# summaries; choose the provider per task in System settings. Buyer research always needs ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=

# Mailbox OAuth apps (see docs/EMAIL_SETUP.md). Configure only the providers you use.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_DC=in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT=common

# Internal notification e-mails (escalations, daily report). Any SMTP account, e.g. Zoho SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Flotec Sales AI <noreply@yourdomain.com>

# Storage / backups
MEDIA_ROOT=/srv/flotec/media
BACKUP_DIR=/srv/flotec/backups
BACKUP_KEEP=14
LOG_DIR=/srv/flotec/logs
